# Cloudflare Pages reads this file and sends these headers with every response.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'

# The filenames never change, so a long cache means a returning customer can
# be served last week's file. For data.js that is the menu and the prices, so
# the scripts revalidate on every visit: a conditional request against an
# unchanged file is a 304 and a few bytes, which is a fair price for never
# quoting someone a stale price.
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Styling and artwork can go stale for a day without misleading anyone.
/assets/css/*
  Cache-Control: public, max-age=86400
/assets/img/*
  Cache-Control: public, max-age=86400

# Fonts never change under the same name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pages themselves should always be fresh — the menu changes weekly.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
